# Paste the full `Cookie: ...` header from a www.kleinanzeigen.de request.
# This is the whole session - treat it like a password.
COOKIE_HEADER=

# Railway volume mount path, so state.json survives redeploys.
STATE_DIR=/data

# Seconds between scans of search page 1.
POLL_SECONDS=120

# 1 = on first run mark current listings as seen without messaging them.
SEED_FIRST_RUN=1

# Optional: POST {"text": "..."} on each send and when the session dies.
WEBHOOK_URL=

# 1 = log matches without sending anything.
DRY_RUN=0
